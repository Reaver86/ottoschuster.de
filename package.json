{
  "name": "ottoschuster.de",
  "version": "1.0.0",
  "description": "Bilingual website for Übersetzungsbüro Schuster",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "deploy": "python3 scripts/deploy.py",
    "dev": "astro dev",
    "build": "npm run validate && astro build",
    "check": "astro check",
    "check:links": "node scripts/check-build.mjs",
    "generate:qr": "node scripts/generate-qr.mjs",
    "preview": "astro preview",
    "validate": "tsx scripts/validate-content.ts",
    "test": "npm run check && npm run build && npm run check:links"
  },
  "dependencies": {
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/qrcode": "^1.5.6",
    "playwright": "^1.64.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true
}
