---
import { getContent } from "../data/content";
import { priceEntries, type Price } from "../data/prices";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getContent(locale);
const pageCopy = copy.pricePage;
const formatter = new Intl.NumberFormat(locale === "de" ? "de-DE" : "ro-RO", {
  style: "currency",
  currency: "EUR",
  minimumFractionDigits: 2,
});

const formatPrice = (price: Price) => {
  if (price.type === "fixed") return `${formatter.format(price.amount)} ${pageCopy.net}`;
  if (price.type === "range") return `${formatter.format(price.min)}–${formatter.format(price.max)} ${pageCopy.net}`;
  if (price.type === "free") return pageCopy.free;
  return pageCopy.quote;
};
---

<div class="price-catalogue" id="price-catalogue">
  <div class="price-list">
    {priceEntries.map((entry) => (
      <article class="price-entry" id={entry.id}>
        <div class="price-entry-description">
          <h2>{entry.name[locale]}</h2>
          {entry.note && <p class="price-note">{entry.note[locale]}</p>}
        </div>
        <div class="price-previews">
          {entry.examples?.map((item) => (
            <a class="document-preview" href={item.file} target="_blank" rel="noopener noreferrer">
              <img src={item.preview} alt={`${entry.name[locale]} – ${item.label[locale]}`} width="160" height="220" loading="lazy" decoding="async" />
              <span>{item.label[locale]}</span>
            </a>
          ))}
        </div>
        <p class:list={["price-value", { quote: entry.price.type === "quote" }]}>{formatPrice(entry.price)}</p>
      </article>
    ))}
  </div>
</div>
