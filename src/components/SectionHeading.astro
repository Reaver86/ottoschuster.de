---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: "left" | "center";
  level?: "h1" | "h2";
}

const { eyebrow, title, intro, align = "left", level = "h2" } = Astro.props;
const Heading = level;
---

<header class:list={["section-heading", `align-${align}`]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading>{title}</Heading>
  {intro && <p class="section-intro">{intro}</p>}
</header>
