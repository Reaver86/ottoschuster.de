---
import Icon from "../Icon.astro";
import { getLegalContent, type LegalLinkId, type LegalParagraph } from "../../data/legal";
import { site } from "../../data/site";
import { getCurrentLocale } from "../../i18n/config";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  type: "imprint" | "privacy";
}

const { type } = Astro.props;
const locale = getCurrentLocale(Astro.currentLocale);
const legal = getLegalContent(locale);
const page = legal[type];

const links: Record<LegalLinkId, { href: string; external: boolean }> = {
  directory: { href: site.directories.justiz, external: true },
  email: { href: `mailto:${site.email}`, external: false },
  whatsappPrivacy: { href: "https://www.whatsapp.com/legal/privacy-policy-eea", external: true },
};

const richParagraph = (paragraph: LegalParagraph) =>
  typeof paragraph === "string" ? undefined : { ...paragraph, ...links[paragraph.link] };
---

<BaseLayout page={type} title={page.metaTitle} description={page.metaDescription}>
  <section class="page-hero legal-page-hero">
    <div class="container page-hero-narrow">
      <p class="eyebrow">{legal.eyebrow}</p>
      <h1>{page.title}</h1>
      <p class="section-intro">{page.intro}</p>
    </div>
  </section>

  <section class="section legal-section">
    <div class="container legal-prose">
      {type === "imprint" ? (
        <>
          <section>
            <h2>{legal.imprint.providerTitle}</h2>
            <p><strong>{site.name}</strong><br />{legal.imprint.ownerLabel}: {site.owner}<br />{site.address.street}<br />{site.address.city}<br />{legal.imprint.country}</p>
          </section>
          <section>
            <h2>{legal.imprint.contactTitle}</h2>
            <p>{legal.imprint.phoneLabel}: <a href={site.phone.landlineHref}>{site.phone.landlineDisplay}</a><br />{legal.imprint.mobileLabel}: <a href={site.phone.mobileHref}>{site.phone.mobileDisplay}</a><br />{legal.imprint.emailLabel}: <a href={`mailto:${site.email}`}>{site.email}</a></p>
          </section>
          <section>
            <h2>{legal.imprint.vatTitle}</h2>
            <p>{legal.imprint.vatText} <strong>{site.vatId}</strong></p>
          </section>
        </>
      ) : (
        <>
          <section>
            <h2>{legal.privacy.controllerTitle}</h2>
            <p><strong>{site.name}</strong><br />{site.owner}<br />{site.address.street}<br />{site.address.city}<br />{legal.privacy.emailLabel}: <a href={`mailto:${site.email}`}>{site.email}</a><br />{legal.privacy.phoneLabel}: <a href={site.phone.landlineHref}>{site.phone.landlineDisplay}</a></p>
          </section>
        </>
      )}
      {page.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph) => {
            const rich = richParagraph(paragraph);
            return rich ? (
              <p>
                {rich.before}<a class:list={{ "inline-external": rich.external }} href={rich.href} target={rich.external ? "_blank" : undefined} rel={rich.external ? "noopener noreferrer" : undefined}>{rich.label}{rich.external && <> <Icon name="external" size={16} /></>}</a>{rich.after}
              </p>
            ) : <p>{paragraph}</p>;
          })}
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
