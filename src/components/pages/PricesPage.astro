---
import ContactBand from "../ContactBand.astro";
import Icon from "../Icon.astro";
import PriceCatalogue from "../PriceCatalogue.astro";
import SectionHeading from "../SectionHeading.astro";
import { getContent } from "../../data/content";
import { assetPath } from "../../data/site";
import { getCurrentLocale } from "../../i18n/config";
import BaseLayout from "../../layouts/BaseLayout.astro";

const locale = getCurrentLocale(Astro.currentLocale);
const copy = getContent(locale);
const page = copy.pricePage;
---

<BaseLayout page="prices" title={page.metaTitle} description={page.metaDescription}>
  <section class="page-hero price-page-hero">
    <img
      class="price-page-hero-image"
      src={assetPath.priceHero}
      width="562"
      height="383"
      alt=""
      aria-hidden="true"
      fetchpriority="high"
    />
    <div class="container page-hero-grid">
      <SectionHeading eyebrow={page.eyebrow} title={page.title} intro={page.intro} level="h1" />
    </div>
  </section>
  <section class="price-facts">
    <div class="container">
      <ul>
        {page.facts.map((fact) => <li><Icon name="check" size={17} />{fact}</li>)}
      </ul>
    </div>
  </section>
  <section class="section catalogue-section">
    <div class="container">
      <PriceCatalogue locale={locale} />
    </div>
  </section>
  <ContactBand locale={locale} />
</BaseLayout>
