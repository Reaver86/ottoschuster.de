---
import ContactBand from "../ContactBand.astro";
import Icon from "../Icon.astro";
import SectionHeading from "../SectionHeading.astro";
import { getContent } from "../../data/content";
import { assetPath, site, type Locale } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = getContent(locale);
const page = copy.contactPage;
---

<BaseLayout locale={locale} page="contact" title={page.metaTitle} description={page.metaDescription}>
  <section class="page-hero contact-page-hero">
    <div class="container page-hero-narrow">
      <SectionHeading eyebrow={page.eyebrow} title={page.title} intro={page.intro} level="h1" />
    </div>
  </section>

  <section class="section contact-options-section">
    <div class="container">
      <a class="whatsapp-panel" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
        <div class="whatsapp-panel-icon"><Icon name="whatsapp" size={34} /></div>
        <div>
          <p class="panel-label">WhatsApp · {site.phone.mobileDisplay}</p>
          <h2>{page.whatsappTitle}</h2>
          <p>{page.whatsappText}</p>
        </div>
        <Icon name="arrow" size={26} />
      </a>

      <div class="contact-card-grid">
        <a class="contact-card" href={site.phone.mobileHref}>
          <div class="contact-card-icon"><Icon name="phone" size={26} /></div>
          <p class="panel-label">{page.phoneTitle}</p>
          <h2>{site.phone.mobileDisplay}</h2>
          <p>{page.phoneText}</p>
          <span>{copy.actions.call}<Icon name="arrow" size={18} /></span>
        </a>
        <a class="contact-card" href={`mailto:${site.email}`}>
          <div class="contact-card-icon"><Icon name="mail" size={26} /></div>
          <p class="panel-label">{page.emailTitle}</p>
          <h2>{site.email}</h2>
          <p>{page.emailText}</p>
          <span>{copy.actions.email}<Icon name="arrow" size={18} /></span>
        </a>
        <div class="contact-card">
          <div class="contact-card-icon"><Icon name="map" size={26} /></div>
          <p class="panel-label">{page.addressTitle}</p>
          <h2>{site.address.street}<br />{site.address.city}</h2>
          <p>{page.addressText}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section prepare-section">
    <div class="container prepare-grid">
      <SectionHeading eyebrow={page.prepare.eyebrow} title={page.prepare.title} />
      <ol>
        {page.prepare.items.map((item, index) => (
          <li><span>{index + 1}</span><p>{item}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section card-section">
    <div class="container card-preview-grid">
      <div>
        <SectionHeading eyebrow={page.card.eyebrow} title={page.card.title} intro={page.card.text} />
        <a class="text-link" href={assetPath.card1440} target="_blank" rel="noopener noreferrer">
          {page.card.link}<Icon name="external" size={18} />
        </a>
      </div>
      <a class="business-card-preview" href={assetPath.card1440} target="_blank" rel="noopener noreferrer">
        <picture>
          <source media="(max-width: 720px)" srcset={assetPath.card720} />
          <img src={assetPath.card1440} width="1440" height="1027" alt={page.card.alt} loading="lazy" />
        </picture>
      </a>
    </div>
  </section>

  <section class="section qr-section">
    <div class="container">
      <SectionHeading eyebrow={page.connect.eyebrow} title={page.connect.title} intro={page.connect.text} />
      <div class="direct-link-list">
        {page.connect.items.map((item) => (
          <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}<Icon name="external" size={17} /></a>
        ))}
      </div>
      <div class="qr-grid">
        {page.connect.items.map((item) => (
          <a class="qr-card" href={item.href} target="_blank" rel="noopener noreferrer">
            <img src={`/qr/${item.id}.svg`} width="220" height="220" alt={`QR-Code: ${item.label}`} loading="lazy" />
            <span>{item.label}<Icon name="external" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <ContactBand locale={locale} />
</BaseLayout>
