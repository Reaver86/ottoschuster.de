---
import ContactBand from "../ContactBand.astro";
import Icon from "../Icon.astro";
import SectionHeading from "../SectionHeading.astro";
import { getContent } from "../../data/content";
import { getCurrentLocale } from "../../i18n/config";
import BaseLayout from "../../layouts/BaseLayout.astro";

const locale = getCurrentLocale(Astro.currentLocale);
const copy = getContent(locale);
const page = copy.infoPage;
---

<BaseLayout page="info" title={page.metaTitle} description={page.metaDescription}>
  <section class="section faq-section">
    <div class="container faq-grid">
      <SectionHeading eyebrow={page.eyebrow} title={page.title} level="h1" />
      <div class="faq-list">
        {page.items.map((item, index) => (
          <details class="faq-item" open={index === 0}>
            <summary><span>{item.question}</span><span class="faq-chevron"><Icon name="chevron" size={20} /></span></summary>
            <div class="faq-answer"><p>{item.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ContactBand locale={locale} />
</BaseLayout>
