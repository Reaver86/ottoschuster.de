---
import { getContent } from "../data/content";
import type { Locale } from "../data/site";
import ContactActions from "./ContactActions.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getContent(locale).home.closing;
---

<section class="contact-band">
  <div class="container contact-band-inner">
    <div class="contact-band-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2>{copy.title}</h2>
      <p>{copy.text}</p>
    </div>
    <ContactActions locale={locale} compact />
  </div>
</section>
