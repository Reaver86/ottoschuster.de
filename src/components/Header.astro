---
import { getContent, navigationOrder } from "../data/content";
import type { Locale, PageId } from "../i18n/config";
import { getLocalizedPath } from "../i18n/routes";
import LanguageToggle from "./LanguageToggle.astro";

interface Props {
  locale: Locale;
  page: PageId;
}

const { locale, page } = Astro.props;
const copy = getContent(locale);
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="wordmark" href={getLocalizedPath("home", locale)}>
      <span class="wordmark-main">Übersetzungsbüro Schuster</span>
      <span class="wordmark-sub">Deutsch <span aria-hidden="true">↔</span> Rumänisch</span>
    </a>

    <nav class="primary-nav" aria-label={copy.navigationLabel}>
      <ul>
        {navigationOrder.map((item) => (
          <li>
            <a href={getLocalizedPath(item, locale)} aria-current={page === item ? "page" : undefined}>{copy.nav[item]}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-tools">
      <LanguageToggle locale={locale} page={page} />
    </div>
  </div>
</header>
