---
import { getContent } from "../data/content";
import { site } from "../data/site";
import type { Locale } from "../i18n/config";
import { getLocalizedPath } from "../i18n/routes";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getContent(locale);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="wordmark footer-wordmark" href={getLocalizedPath("home", locale)}>
        <span class="wordmark-main">Übersetzungsbüro Schuster</span>
      </a>
    </div>

    <div>
      <h2>{copy.footer.contact}</h2>
      <ul class="footer-links footer-contact-links icon-links">
        <li><a href={site.phone.mobileHref} data-analytics-event="contact-phone"><Icon name="phone" size={18} />{site.phone.mobileDisplay}</a></li>
        <li><a href={site.whatsapp} data-analytics-event="contact-whatsapp" target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={18} />WhatsApp</a></li>
        <li class="footer-email"><a href={`mailto:${site.email}`} data-analytics-event="contact-email"><Icon name="mail" size={18} />{site.email}</a></li>
      </ul>
      <address class="footer-address">
        {site.address.street}<br />
        {site.address.city}
      </address>
    </div>

    <div>
      <h2>{copy.footer.legal}</h2>
      <ul class="footer-links footer-legal-links">
        <li><a href={getLocalizedPath("imprint", locale)}>{copy.footer.imprint}</a></li>
        <li><a href={getLocalizedPath("privacy", locale)}>{copy.footer.privacy}</a></li>
      </ul>
    </div>
  </div>
</footer>
