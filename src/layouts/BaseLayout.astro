---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { getContent } from "../data/content";
import { assetPath } from "../data/site";
import { getCurrentLocale, type PageId } from "../i18n/config";
import { getLocalizedUrl } from "../i18n/routes";

interface Props {
  page: PageId;
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const {
  page,
  title,
  description,
  image = assetPath.portrait900,
  noindex = false,
} = Astro.props;
const locale = getCurrentLocale(Astro.currentLocale);
const copy = getContent(locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
const deUrl = getLocalizedUrl(page, "de");
const roUrl = getLocalizedUrl(page, "ro");
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#fcfbf8" />
    <link rel="icon" href={assetPath.favicon} type="image/svg+xml" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="ro" href={roUrl} />
    <link rel="alternate" hreflang="x-default" href={deUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "de" ? "de_DE" : "ro_RO"} />
    <meta property="og:locale:alternate" content={locale === "de" ? "ro_RO" : "de_DE"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skipLink}</a>
    <Header locale={locale} page={page} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
